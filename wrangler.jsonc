{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "margaret-memorial",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Replace database_id after `wrangler d1 create margaret-memorial`
  "d1_databases": [
    { "binding": "DB", "database_name": "margaret-memorial", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "margaret-memorial-photos" }],
  "vars": {
    // Cloudflare's always-pass test key for local work. Set the real one with `wrangler secret put TURNSTILE_SECRET`.
    "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
    // Fill these in once Cloudflare Access protects /admin and /api/admin/*
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Local only: lets /api/admin work without Access. Never "1" in production.
    "DEV_ADMIN": "0"
  }
}
