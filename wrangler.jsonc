{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "margaret-memorial",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "margaret.memorial", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/", "/admin.html"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "margaret-memorial", "database_id": "43b74966-d7a3-4e5c-8c19-e1733e67468a" }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "margaret-memorial-photos" }],
  // TURNSTILE_SECRET, ACCESS_TEAM_DOMAIN and ACCESS_AUD are set in the Cloudflare dashboard
  // (Worker > Settings > Variables and Secrets). keep_vars stops deploys from wiping them.
  // For local work, copy .dev.vars.example to .dev.vars.
  "keep_vars": true,
  "observability": { "enabled": true }
}
