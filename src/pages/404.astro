---
import Base from "../layouts/Base.astro";
---
<Base title="Not found · Margaret">
  <main class="shell" style="min-height:70vh;display:grid;place-items:center;text-align:center">
    <div style="display:flex;flex-direction:column;gap:18px;align-items:center">
      <span class="label">Not found</span>
      <h1 style="font:italic 400 clamp(2rem,6vw,3.6rem)/1.1 var(--f-display)">This page has wandered off.</h1>
      <a class="btn ghost" href="/">Back to Margaret’s story</a>
    </div>
  </main>
</Base>
